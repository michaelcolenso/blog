<!DOCTYPE html>
<html>
  <head>
    <title>Stillroom - Photography Portfolio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-950 font-sans antialiased">
    <nav class="border-b border-stone-800 bg-stone-950/95 text-stone-100 backdrop-blur">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to "Stillroom", root_path, class: "text-2xl font-light tracking-[0.35em] text-stone-100" %>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <%= link_to "Dashboard", dashboard_path, class: "text-stone-300 hover:text-amber-100" %>
              <%= link_to "My Page", edit_page_path, class: "text-stone-300 hover:text-amber-100" %>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-stone-300 hover:text-amber-100" %>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "text-stone-300 hover:text-amber-100" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "rounded-full bg-stone-100 px-4 py-2 text-stone-950 hover:bg-amber-200" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="mx-auto mt-4 max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mx-auto mt-4 max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
